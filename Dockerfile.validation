FROM rust:1.96.1-alpine3.24
RUN apk --no-cache add musl-dev perl make postgresql16-client
RUN wget -O /usr/local/bin/tailwindcss https://github.com/tailwindlabs/tailwindcss/releases/download/v4.0.17/tailwindcss-linux-x64-musl
RUN chmod +x /usr/local/bin/tailwindcss

WORKDIR /app
COPY . .

RUN cargo build --release -p gitjobs-server
RUN cargo test --no-run --release -p gitjobs-server

ENTRYPOINT ["cargo", "test", "--release", "-p", "gitjobs-server"]
